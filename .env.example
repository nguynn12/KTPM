# Paperless-ngx Template Configuration — TV1
# Sao chep file nay thanh `.env` roi SUA 2 gia tri bat buoc ben duoi.
# `.env` da bi .gitignore chan — KHONG commit secret/mat khau that.
#   PowerShell: Copy-Item .env.example .env
#   Bash/WSL:   cp .env.example .env
# Sinh SECRET:  py -3.13 -c "import secrets; print(secrets.token_urlsafe(64))"

# BAT BUOC DOI. Khong dung gia tri mau nay khi chay that.
PAPERLESS_SECRET_KEY=change-me-to-a-secure-random-key
PAPERLESS_URL=http://localhost:8000
PAPERLESS_TIME_ZONE=Asia/Ho_Chi_Minh
PAPERLESS_OCR_LANGUAGE=eng

# Tai khoan admin tao tu dong o lan khoi dong dau. BAT BUOC DOI mat khau.
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=admin
PAPERLESS_ADMIN_MAIL=admin@localhost.local
PAPERLESS_TIKA_ENABLED=0
PAPERLESS_ENABLE_HTTP_REMOTE_USER=false
