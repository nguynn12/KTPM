###############################################################################
# Paperless-ngx settings — bản mẫu của nhóm (TV1), nguồn: file gốc tại v3.1.3
# Copy thành `docker-compose.env` rồi SỬA SECRET. Không commit file thật lên Git.
# Docs đầy đủ: https://docs.paperless-ngx.com/configuration/
###############################################################################

# BẮT BUỘC ĐỔI. Sinh bằng: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=change-me

# Múi giờ của nhóm
PAPERLESS_TIME_ZONE=Asia/Ho_Chi_Minh

# Ngôn ngữ OCR chính của bộ seed (tiếng Anh). Tài liệu tiếng Việt: đặt vie.
PAPERLESS_OCR_LANGUAGE=eng

# Chạy local nên giữ comment dòng URL công khai:
#PAPERLESS_URL=https://paperless.example.com

# UID/GID để container ghi được thư mục consume trên Linux (mở khi bị lỗi permission):
#USERMAP_UID=1000
#USERMAP_GID=1000
